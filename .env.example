# Names only, never values. Copy to .env (gitignored) or export them in your shell.
# None is required: bin/setup, bin/check and bin/dev work with every variable unset.

# Test database (bin/setup, bin/check). Unset: the bss-pg container on 127.0.0.1:55432.
DATABASE_URL=
# Private database on the bss-pg server, created on first use; one per agent sharing a checkout.
BSS_TEST_DB=
# Container that bin/setup starts and bin/stop stops (defaults in bin/_dx.sh).
BSS_PG_CONTAINER=
BSS_PG_PORT=
BSS_PG_IMAGE=

# Integration app (bin/dev, integration*/config/database.yml). bin/dev ignores DATABASE_URL.
PORT=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# MCP servers in .mcp.json. A server whose variables are unset fails to connect; the rest keep working.
# sentry-mcp
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=
# developerz (https://mcp.developerz.ai)
DEVELOPERZ_API_KEY=
